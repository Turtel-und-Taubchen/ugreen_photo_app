# ExifTool configuration: XMP namespace "photocurator" for the app's own review state.
# Every ExifTool call that reads or writes these tags must pass -config with this file.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        photocurator => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::photocurator' },
        },
    },
);

%Image::ExifTool::UserDefined::photocurator = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-photocurator', 2 => 'Image' },
    NAMESPACE => { 'photocurator' => 'http://ns.photocurator.invalid/1.0/' },
    WRITABLE  => 'string',
    ReviewState => { },
    ReviewedAt  => { Writable => 'date' },
);

1;  # a config file must return true
