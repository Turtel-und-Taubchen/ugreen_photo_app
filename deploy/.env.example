# Docker-Image, das gestartet wird.
PC_IMAGE=photocurator:latest
# Host-Pfad der sortierten Fotos (niemals die Inbox).
PHOTOS_PATH=/volume1/Gemeinsame Fotos/Sortiert
# Host-Pfad für Index und Konfiguration der App.
DATA_PATH=/volume1/docker/photocurator/data
# Host-Pfad für Sicherungen vor Änderungen.
BACKUP_PATH=/volume1/docker/photocurator/backup
# Numerische UID des UGOS-Nutzers mit Schreibrecht auf die Fotos.
PUID=1000
# Numerische GID dieses Nutzers.
PGID=10
# Host-Port, unter dem die Oberfläche erreichbar ist.
PORT=8470
# Host-IP, an die der Port gebunden wird (0.0.0.0 = alle Schnittstellen).
BIND_IP=0.0.0.0
# Zeitzone des Containers.
TZ=Europe/Vienna
# Kontakt (E-Mail) für die Nominatim-Nutzungsrichtlinie.
NOMINATIM_CONTACT=name@example.com
